DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://user:password@localhost:5432/coffeechain
OTP_CODE_LENGTH=4
OTP_EXPIRY_MINUTES=10
IPFS_GATEWAY_URL=https://ipfs.io/ipfs/
STORACHA_UPLOAD_URL=http://localhost:3001/upload
POLYGON_RPC_URL=
POLYGON_CONTRACT_ADDRESS=
POLYGON_PRIVATE_KEY=

# SMS gateway: simulated | africas_talking | twilio
SMS_PROVIDER=simulated

# Africa's Talking sandbox (username MUST be "sandbox")
# Sandbox accepts SMS but does NOT deliver to real handsets — use:
#   https://simulator.africastalking.com:1517/ (register test numbers there)
# For real phone SMS, use a live AT app username + production API key (not sandbox).
# 1. Sandbox → Settings → API Key → Generate (wait 5–20 min)
# 2. Register test phones: Sandbox → Phone numbers AND the simulator URL above
AT_USERNAME=sandbox
AT_API_KEY=your_sandbox_atsk_key_here
AT_SENDER_ID=
AT_BASE_URL=https://api.sandbox.africastalking.com/version1/messaging

# Twilio: https://console.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

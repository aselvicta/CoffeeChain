DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://user:password@localhost:5432/coffeechain
OTP_CODE_LENGTH=4
OTP_EXPIRY_MINUTES=10
IPFS_GATEWAY_URL=https://ipfs.io/ipfs/
STORACHA_UPLOAD_URL=http://localhost:3001/upload
POLYGON_RPC_URL=
POLYGON_CONTRACT_ADDRESS=
POLYGON_PRIVATE_KEY=

# SMS for farmer OTP — recommended for Tanzania: Africa's Talking (live app)
# Options: africas_talking | twilio | simulated
SMS_PROVIDER=africas_talking
AT_USERNAME=your_app_username
AT_API_KEY=your_atsk_key_here
AT_SENDER_ID=
AT_BASE_URL=https://api.africastalking.com/version1/messaging

# Twilio — https://console.twilio.com/docs/messaging/quickstart
# 1. Account SID + Auth Token from console home
# 2. TWILIO_FROM_NUMBER = your Twilio number (E.164)
# 3. Trial cannot SMS Tanzania (+255) from a US number — use Virtual Phone mode:
TWILIO_TRIAL_DESTINATION=virtual_phone
TWILIO_VIRTUAL_PHONE=+18777804236
# Open https://console.twilio.com/us1/develop/sms/try-it-out/send → Virtual Phone tab
# For real +255 handsets: upgrade Twilio + geo permissions, or use africas_talking live
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# Retailer point-of-sale: subsidy discount % for Ministry-verified buyers
RETAILER_MINISTRY_DISCOUNT_PERCENT=10

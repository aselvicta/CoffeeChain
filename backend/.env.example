DJANGO_SECRET_KEY=replace-me

DJANGO_DEBUG=true

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgres://user:password@localhost:5432/coffeechain

IPFS_GATEWAY_URL=https://ipfs.io/ipfs/

STORACHA_UPLOAD_URL=http://localhost:3001/upload

POLYGON_RPC_URL=

POLYGON_CONTRACT_ADDRESS=

POLYGON_PRIVATE_KEY=



# Farmer OTP — Briq Karibu only (https://docs.briq.tz/)

SMS_PROVIDER=briq

OTP_CODE_LENGTH=6

OTP_EXPIRY_MINUTES=10

BRIQ_API_KEY=your_briq_api_key

BRIQ_APP_KEY=your_developer_app_key

BRIQ_BASE_URL=https://karibu.briq.tz

BRIQ_OTP_SENDER_ID=BRIQ

BRIQ_OTP_LANGUAGE=en

BRIQ_OTP_PRIMARY_METHOD=sms
BRIQ_OTP_RESEND_METHOD=call
BRIQ_OTP_LOCAL_FALLBACK=false

# Optional custom SMS template (must include {code} and {expiry}):

# BRIQ_OTP_MESSAGE_TEMPLATE=CoffeeChain: Your code is {code}. Expires in {expiry} minutes.



# Retailer point-of-sale: subsidy discount % for Ministry-verified buyers

RETAILER_MINISTRY_DISCOUNT_PERCENT=10


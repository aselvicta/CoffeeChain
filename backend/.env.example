DJANGO_SECRET_KEY=replace-me

DJANGO_DEBUG=true

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgres://user:password@localhost:5432/coffeechain

IPFS_GATEWAY_URL=https://w3s.link/ipfs/

# Receipt storage: Storacha first (upload service), backend disk + DB fallback.
STORACHA_UPLOAD_URL=http://localhost:3001/upload
# On Render, set STORACHA_UPLOAD_HOST instead (wired automatically in render.yaml).
STORACHA_UPLOAD_ENABLED=true

BACKEND_PUBLIC_URL=http://127.0.0.1:8000
RECEIPT_CALLBACK_SECRET=replace-with-a-long-random-secret

POLYGON_RPC_URL=

POLYGON_CONTRACT_ADDRESS=

POLYGON_PRIVATE_KEY=



# Farmer OTP — Briq Karibu only (https://docs.briq.tz/)

SMS_PROVIDER=briq

OTP_CODE_LENGTH=6

OTP_EXPIRY_MINUTES=10

BRIQ_API_KEY=your_briq_api_key

BRIQ_APP_KEY=your_developer_app_key

BRIQ_BASE_URL=https://karibu.briq.tz

BRIQ_OTP_SENDER_ID=BRIQ

BRIQ_OTP_LANGUAGE=en

BRIQ_OTP_PRIMARY_METHOD=sms
BRIQ_OTP_RESEND_METHOD=call
BRIQ_OTP_LOCAL_FALLBACK=false

# Integrity tamper alerts — SMS always; WhatsApp via approved template (parallel, either can fail).
BRIQ_INTEGRITY_ALERT_WHATSAPP=true
# Approved template in Briq console, e.g. body: "Alert: {{1}}. {{2}} Login to CoffeeChain."
BRIQ_INTEGRITY_WHATSAPP_TEMPLATE=
# Optional WhatsApp sender (phone_number_id or number) if workspace has multiple senders.
# BRIQ_WHATSAPP_SENDER=

# Optional custom SMS template (must include {code} and {expiry}):
# Placeholders: {bags}, {fertilizer}, {farmer_name}, {branch}, {batch}
# BRIQ_OTP_MESSAGE_TEMPLATE=CoffeeChain: Hi {farmer_name}, confirm receipt of {bags} bag(s) of {fertilizer} from {branch}. Code {code}. Expires in {expiry} min.



# Retailer point-of-sale: subsidy discount % for Ministry-verified buyers

RETAILER_MINISTRY_DISCOUNT_PERCENT=10

# Integrity watcher — alerts when pgAdmin / direct SQL edits anchored transfers
INTEGRITY_WATCHER_ENABLED=true
INTEGRITY_WATCHER_INTERVAL_SECONDS=30
INTEGRITY_WATCHER_FULL_SCAN_EVERY=4

# ── Email (registration approve/reject + transfer receipts) ──────────────────
# Dev default prints to the Django console. For real SMTP (e.g. Gmail App Password):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=your@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=CoffeeChain <your@gmail.com>
# FRONTEND_URL=http://localhost:5173

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=CoffeeChain <noreply@coffeechain.local>
FRONTEND_URL=http://localhost:5173
